{
  "name": "jev-dependency-benchmark",
  "version": "1.0.0",
  "description": "Independent benchmark of JEV for dependency-update automation under distribution shift.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "author": "Alen Lawrance, Harikrishnan PS, Vishnu Prakash",
  "license": "MIT",
  "scripts": {
    "bump": "node scripts/build_bump.mjs",
    "controls": "node scripts/build_controls.mjs && node scripts/verify_controls.mjs",
    "dataset": "node scripts/build_dataset.mjs",
    "audit": "tsx src/audit.ts",
    "schema-check": "tsx src/schema-check.ts",
    "benchmark": "tsx src/run.ts",
    "mock": "MOCK=1 tsx src/run.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "openai": "7.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
